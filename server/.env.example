PORT=3002
NODE_ENV=development

# Segredo criptográfico do token JWT de sessão (validade de 24h para cobrir todo o evento):
JWT_SECRET=your-secret-key-here

# Google OAuth 2.0 Web Client ID:
GOOGLE_CLIENT_ID=

# Projeto Google Cloud Firestore (vota-v2):
GOOGLE_CLOUD_PROJECT=vota-v2
FIRESTORE_DATABASE_ID=(default)

# Lista de e-mails de administradores autorizados separados por vírgula:
ADMIN_EMAILS=thiago.luiz@colegiocarbonell.com.br,patricia.santos@colegiocarbonell.com.br,marina.ribeiro@colegiocarbonell.com.br,raquel.favatto@colegiocarbonell.com.br
